@{
    var baslik = ViewData["Title"] as string;
    var sayfaBasligi = string.IsNullOrWhiteSpace(baslik)
        ? "Muhammed Sefa Tayaz"
        : $"{baslik} — Muhammed Sefa Tayaz";

    var aciklama = ViewData["Description"] as string
        ?? "Muhammed Sefa Tayaz — yazılım geliştirici. .NET ile çok kiracılı SaaS ürünlerinin arka ucunu kuruyorum.";

    var acikEylem = ViewContext.RouteData.Values["action"]?.ToString();

    Func<string, bool> aktif = eylem => string.Equals(eylem, acikEylem, StringComparison.OrdinalIgnoreCase);

    // Bulunulan sayfanın altında royal bir çizgi durur; diğerlerinde çizgi
    // yalnızca imleç üzerine gelince soldan sağa açılır.
    Func<string, string> menuSinifi = eylem => aktif(eylem)
        ? "text-royal after:scale-x-100 after:bg-royal"
        : "text-slate hover:text-ink after:scale-x-0 after:bg-ink/50 hover:after:scale-x-100";

    Func<string, string> mobilMenuSinifi = eylem => aktif(eylem)
        ? "border-l-2 border-royal pl-[14px] text-royal"
        : "border-l-2 border-transparent pl-[14px] text-slate hover:text-royal";
}
<!DOCTYPE html>
<html lang="tr" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@sayfaBasligi</title>
    <meta name="description" content="@aciklama" />
    <meta name="author" content="Muhammed Sefa Tayaz" />
    <meta name="theme-color" content="#0F172A" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://msefatayaz.com/" />
    <meta property="og:title" content="@sayfaBasligi" />
    <meta property="og:description" content="@aciklama" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='4' fill='%230F172A'/%3E%3Cpath d='M18 44V20h5l9 15 9-15h5v24h-5V29l-7 12h-4l-7-12v15z' fill='%23FAFAFB'/%3E%3C/svg%3E" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* Gizleme kuralları yalnızca JavaScript varken uygulansın diye en başta çalışır. *@
    <script>document.documentElement.classList.remove('no-js');</script>
</head>
<body id="ust" class="flex min-h-[100svh] flex-col font-sans text-ink antialiased selection:bg-ink selection:text-paper">

    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-[14px] focus:text-paper"
       href="#icerik">İçeriğe geç</a>

    <header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-sm">

        @* Sayfanın üstünde ince renkli şerit *@
        <div class="h-[3px] w-full bg-gradient-to-r from-royal via-royal to-ember" aria-hidden="true"></div>

        <div class="border-b border-hairline">
            <div class="mx-auto flex h-16 max-w-4xl items-stretch justify-between gap-4 px-6 sm:px-10">

                <a class="group flex items-center gap-2.5" asp-controller="Home" asp-action="Index" aria-label="Ana sayfa">
                    <span class="grid h-8 w-8 shrink-0 place-items-center bg-ink text-[13px] font-semibold tracking-tight text-paper transition-colors group-hover:bg-royal"
                          aria-hidden="true">MS</span>
                    <span class="text-[15px] font-medium tracking-tight text-ink">msefatayaz<span class="text-royal">.com</span></span>
                </a>

                @* Masaüstü menüsü — alt çizgi başlıktaki ince çizgiyle hizalanır *@
                <nav class="hidden items-stretch gap-7 sm:flex" aria-label="Ana menü">
                    <a class="relative flex items-center text-[15px] transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:origin-left after:transition-transform after:duration-200 after:content-[''] @menuSinifi("Index")"
                       asp-controller="Home" asp-action="Index">Anasayfa</a>
                    <a class="relative flex items-center text-[15px] transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:origin-left after:transition-transform after:duration-200 after:content-[''] @menuSinifi("About")"
                       asp-controller="Home" asp-action="About">Hakkımda</a>
                    <a class="relative flex items-center text-[15px] transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:origin-left after:transition-transform after:duration-200 after:content-[''] @menuSinifi("Projects")"
                       asp-controller="Home" asp-action="Projects">Projelerim</a>
                    <a class="relative flex items-center text-[15px] transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:origin-left after:transition-transform after:duration-200 after:content-[''] @menuSinifi("Contact")"
                       asp-controller="Home" asp-action="Contact">İletişim</a>
                </nav>

                @* Mobil menü — JavaScript olmadan açılıp kapanır *@
                <details class="group relative flex items-center sm:hidden">
                    <summary class="flex cursor-pointer list-none items-center gap-2 border border-hairline px-3 py-2 text-[14px] font-medium text-ink [&::-webkit-details-marker]:hidden">
                        Menü
                        <svg class="h-4 w-4 text-muted transition-transform group-open:rotate-180"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </summary>

                    <nav class="absolute right-0 top-full z-50 mt-2 w-48 border border-hairline bg-paper py-1 shadow-lg shadow-ink/5" aria-label="Ana menü">
                        <a class="block py-3 pr-4 text-[14px] font-medium transition-colors @mobilMenuSinifi("Index")"
                           asp-controller="Home" asp-action="Index">Anasayfa</a>
                        <a class="block py-3 pr-4 text-[14px] font-medium transition-colors @mobilMenuSinifi("About")"
                           asp-controller="Home" asp-action="About">Hakkımda</a>
                        <a class="block py-3 pr-4 text-[14px] font-medium transition-colors @mobilMenuSinifi("Projects")"
                           asp-controller="Home" asp-action="Projects">Projelerim</a>
                        <a class="block py-3 pr-4 text-[14px] font-medium transition-colors @mobilMenuSinifi("Contact")"
                           asp-controller="Home" asp-action="Contact">İletişim</a>
                    </nav>
                </details>

            </div>
        </div>
    </header>

    <main id="icerik" class="flex-1">
        <div class="mx-auto w-full max-w-4xl px-6 py-16 sm:px-10 sm:py-20">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto bg-ink text-paper">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-10 sm:py-14">

            <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">

                <div class="max-w-[38ch]">
                    <p class="flex items-center gap-2.5 text-[15px] font-medium">
                        <span class="grid h-8 w-8 shrink-0 place-items-center bg-paper/10 text-[13px] font-semibold text-paper" aria-hidden="true">MS</span>
                        Muhammed Sefa Tayaz
                    </p>
                    <p class="mt-4 text-[14px] leading-[1.6] text-paper/60">
                        .NET ile arka uç ve çok kiracılı SaaS ürünleri geliştiriyorum.
                    </p>
                </div>

                <nav class="flex flex-col gap-2.5 text-[14px] text-paper/60" aria-label="Alt menü">
                    <a class="transition-colors hover:text-paper" asp-controller="Home" asp-action="About">Hakkımda</a>
                    <a class="transition-colors hover:text-paper" asp-controller="Home" asp-action="Projects">Projelerim</a>
                    <a class="transition-colors hover:text-paper" asp-controller="Home" asp-action="Contact">İletişim</a>
                    <a class="transition-colors hover:text-paper" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                </nav>

                <div class="flex flex-col gap-2.5 text-[14px] text-paper/60">
                    <a class="transition-colors hover:text-paper" href="mailto:sefatayaz@gmail.com">sefatayaz@gmail.com</a>
                    <a class="transition-colors hover:text-paper" href="https://github.com/MuhammedSefaT" target="_blank" rel="noopener">GitHub</a>
                    <a class="transition-colors hover:text-paper" href="https://www.linkedin.com/in/msefatyz" target="_blank" rel="noopener">LinkedIn</a>
                </div>

            </div>

            <div class="mt-12 flex flex-col-reverse gap-4 border-t border-paper/15 pt-6 text-[13px] text-paper/50 sm:flex-row sm:items-center sm:justify-between">
                <p>&copy; @DateTime.Now.Year Muhammed Sefa Tayaz · Türkiye</p>

                <a class="inline-flex items-center gap-2 self-start border border-paper/20 px-3.5 py-2 text-paper/70 transition-colors hover:border-paper/50 hover:text-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
                   href="#ust">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 19V5" />
                        <path d="m5 12 7-7 7 7" />
                    </svg>
                    Yukarı çık
                </a>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
