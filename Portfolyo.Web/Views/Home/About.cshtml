@{
    ViewData["Title"] = "Hakkımda";
    ViewData["Etiket"] = "Tanışalım";
    ViewData["Lede"] = "Arka uçta çalışan bir yazılım geliştiriciyim. Bir sistemin kurallarını netleştirmeyi ve kararları sonradan sökülmeyecek şekilde vermeyi önemsiyorum.";
    ViewData["Description"] = "Muhammed Sefa Tayaz kimdir, nasıl çalışır ve hangi araçları kullanır.";
}

<partial name="_SayfaBasligi" />

@* ------------------------------------------------------ Portre ve hikâye *@
<section class="bg-white">
    <div class="kapsayici py-20 lg:py-28">
        <div class="grid gap-14 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-20">

            @* Kendi fotoğrafını eklemek için: wwwroot/img klasörüne koyup src değerini değiştir. *@
            <figure class="lg:sticky lg:top-28 lg:self-start" data-reveal>
                <img class="w-full rounded-2xl border border-line object-cover shadow-kart"
                     src="~/img/portre.svg"
                     width="800" height="1000"
                     alt="Muhammed Sefa Tayaz" />

                <figcaption class="kart mt-6 divide-y divide-line">
                    <div class="flex items-center justify-between gap-4 px-5 py-3.5 text-[14.5px]">
                        <span class="text-muted">Konum</span>
                        <span class="font-semibold text-ink">Türkiye</span>
                    </div>
                    <div class="flex items-center justify-between gap-4 px-5 py-3.5 text-[14.5px]">
                        <span class="text-muted">Uzmanlık</span>
                        <span class="font-semibold text-ink">Arka uç</span>
                    </div>
                    <div class="flex items-center justify-between gap-4 px-5 py-3.5 text-[14.5px]">
                        <span class="text-muted">Arayüz</span>
                        <span class="font-semibold text-ink">Vue.js</span>
                    </div>
                </figcaption>
            </figure>

            <div data-reveal>
                <p class="etiket">Kısaca</p>
                <h2 class="baslik-bolum mt-5">Sistemin kurallarını netleştirmeyi severim</h2>

                <div class="mt-7 space-y-5 text-[16.5px] leading-[1.8]">
                    <p>
                        Bir işe başlarken önce üç soruyu yanıtlıyorum: veri nereye yazılır, kim
                        neye erişir, bir şey ters gittiğinde ne olur. Bunlar netleşmeden yazılan
                        kod, sonradan sökülmesi pahalı kararlar demek.
                    </p>
                    <p>
                        .NET ile servis ve API geliştiriyorum. Çok kiracılı yapılarda her
                        müşterinin verisini birbirinden ayrı tutan katmanları kuruyorum;
                        yetkilendirmeyi rol ve izin seviyesinde çözüyorum.
                    </p>
                    <p>
                        Arayüz gerektiğinde Vue.js ve Tailwind ile tamamlıyorum. Bu siteyi de
                        sıfırdan yazıyorum: veritabanı yerine JSON dosyaları, katmanlı bir klasör
                        yapısı ve testlerle.
                    </p>
                </div>

                <div class="mt-10 grid gap-5 sm:grid-cols-2">
                    <div class="kart p-6">
                        <span class="ikon-kutu" aria-hidden="true">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="m9 12 2 2 4-4" />
                                <circle cx="12" cy="12" r="9" />
                            </svg>
                        </span>
                        <h3 class="mt-5 text-[17px] font-bold">Sürdürülebilir kod</h3>
                        <p class="mt-2 text-[15px] leading-[1.7]">
                            Altı ay sonra geri dönüldüğünde anlaşılan, değiştirilebilen bir yapı.
                        </p>
                    </div>

                    <div class="kart p-6">
                        <span class="ikon-kutu" aria-hidden="true">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z" />
                            </svg>
                        </span>
                        <h3 class="mt-5 text-[17px] font-bold">Güvenlik önce</h3>
                        <p class="mt-2 text-[15px] leading-[1.7]">
                            Yetkilendirme ve veri yalıtımı sonradan eklenen bir özellik değil.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ------------------------------------------------------------- Araçlar *@
<section class="border-t border-line bg-surface">
    <div class="kapsayici py-20 lg:py-28">

        <div class="max-w-2xl" data-reveal>
            <p class="etiket">Teknoloji</p>
            <h2 class="baslik-bolum mt-5">Kullandığım araçlar</h2>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal>

            <div class="kart p-7">
                <h3 class="text-[17px] font-bold">Arka uç</h3>
                <div class="mt-5 flex flex-wrap gap-2.5">
                    <span class="rozet">C#</span>
                    <span class="rozet">.NET</span>
                    <span class="rozet">ASP.NET Core MVC</span>
                </div>
            </div>

            <div class="kart p-7">
                <h3 class="text-[17px] font-bold">Arayüz</h3>
                <div class="mt-5 flex flex-wrap gap-2.5">
                    <span class="rozet">Vue.js</span>
                    <span class="rozet">Tailwind CSS</span>
                    <span class="rozet">JavaScript</span>
                </div>
            </div>

            <div class="kart p-7">
                <h3 class="text-[17px] font-bold">Test ve araçlar</h3>
                <div class="mt-5 flex flex-wrap gap-2.5">
                    <span class="rozet">xUnit</span>
                    <span class="rozet">Git</span>
                    <span class="rozet">AutoMapper</span>
                    <span class="rozet">FluentValidation</span>
                </div>
            </div>

        </div>
    </div>
</section>

@* ------------------------------------------------------------- CTA bandı *@
<section class="koyu-bolum">
    <div class="kapsayici py-16 lg:py-20">
        <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between" data-reveal>
            <div>
                <h2 class="baslik-bolum text-white">Birlikte çalışalım mı?</h2>
                <p class="mt-4 max-w-[52ch] text-[17px] leading-[1.7] text-white/65">
                    Aklınızdaki projeyi konuşmak için bana yazmanız yeterli.
                </p>
            </div>

            <a class="dugme dugme-beyaz shrink-0" asp-controller="Home" asp-action="Contact">
                İletişime geç
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
