@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    ViewData["MainAlign"] = "justify-start";
}

<h1 class="reveal d2 display text-[clamp(1.6rem,4.2vw,2.2rem)] font-semibold">Bir hata oluştu.</h1>
<p class="reveal d3 mt-6 max-w-[52ch] text-[17px] leading-[1.65] text-slate">
    İsteğiniz işlenirken beklenmeyen bir sorun yaşandı.
</p>

@if (Model.ShowRequestId)
{
    <p class="reveal d4 mt-6 text-[13px] text-muted">
        <strong class="font-medium">İstek No:</strong>
        <code class="rounded bg-ink/5 px-1.5 py-0.5 font-mono">@Model.RequestId</code>
    </p>
}
