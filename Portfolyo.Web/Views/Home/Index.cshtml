@{
    ViewData["Title"] = null;
    ViewData["MainAlign"] = "justify-start";
}

@* ---------------------------------------------------------------- Hero *@
<section class="flex min-h-[56svh] flex-col justify-center">

    <p class="reveal d2 eyebrow">yazılım geliştirici · arka uç</p>

    <h1 class="reveal d2 display mt-5 max-w-2xl text-[clamp(2.4rem,7.2vw,4.4rem)] font-semibold">
        Muhammed Sefa Tayaz
