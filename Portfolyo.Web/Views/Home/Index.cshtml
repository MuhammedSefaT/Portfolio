    <div class="meta mt-10 flex flex-wrap gap-x-6 gap-y-2 text-muted">
        <a class="transition-colors hover:text-royal" href="https://github.com/MuhammedSefaT" target="_blank" rel="noopener">github.com/MuhammedSefaT</a>
        <a class="transition-colors hover:text-royal" href="https://www.linkedin.com/in/msefatyz" target="_blank" rel="noopener">linkedin.com/in/msefatyz</a>
