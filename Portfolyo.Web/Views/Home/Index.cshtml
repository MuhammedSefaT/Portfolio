@{
    ViewData["Title"] = null;
}

@* ---------------------------------------------------------------- Hero *@
<section class="koyu-bolum">
    <div class="kapsayici py-20 lg:py-28">
        <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_1fr]">

            <div>
                <p class="reveal d1 rozet rozet-koyu">
                    <span class="h-2 w-2 rounded-full bg-brand-light" aria-hidden="true"></span>
                    .NET · Arka uç geliştirici · Türkiye
                </p>

                <h1 class="reveal d2 baslik-dev mt-7 text-white">
                    Arka uçta
                    <span class="text-brand-light">sağlam temeller</span>
                    kuruyorum.
                </h1>

                <p class="reveal d3 mt-7 max-w-[56ch] text-[17px] leading-[1.75] text-white/65 lg:text-[18px]">
                    .NET ile çok kiracılı SaaS ürünlerinin arka ucunu geliştiriyorum.
                    Veri nereye yazılır, kim neye erişir, bir şey ters gittiğinde ne olur —
                    işe bu soruları netleştirerek başlıyorum.
                </p>

                <div class="reveal d4 mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <a class="dugme dugme-beyaz" asp-controller="Home" asp-action="Projects">
                        Projelerimi incele
                        <span aria-hidden="true">→</span>
                    </a>
                    <a class="dugme dugme-hayalet" asp-controller="Home" asp-action="Contact">
                        İletişime geç
                    </a>
                </div>

                <div class="reveal d5 mt-12 flex flex-wrap gap-2.5">
                    <span class="rozet rozet-koyu">C#</span>
                    <span class="rozet rozet-koyu">.NET</span>
                    <span class="rozet rozet-koyu">ASP.NET Core</span>
                    <span class="rozet rozet-koyu">Vue.js</span>
                    <span class="rozet rozet-koyu">Tailwind CSS</span>
                </div>
            </div>

            @* Mimari katmanları gösteren özet kart *@
            <div class="reveal d3 kart kart-koyu hidden p-7 lg:block">
                <p class="font-display text-[13px] font-bold uppercase tracking-[.12em] text-brand-light">Katmanlı mimari</p>

                <div class="mt-6 space-y-3">
                    <div class="rounded-xl border border-white/10 bg-white/[.03] p-4">
                        <p class="font-display text-[15px] font-bold text-white">Sunum</p>
                        <p class="mt-1 text-[13.5px] text-white/55">Controller, görünüm, doğrulama</p>
                    </div>
                    <div class="rounded-xl border border-white/10 bg-white/[.03] p-4">
                        <p class="font-display text-[15px] font-bold text-white">Uygulama</p>
                        <p class="mt-1 text-[13.5px] text-white/55">Servisler, iş kuralları, DTO'lar</p>
                    </div>
                    <div class="rounded-xl border border-brand-light/30 bg-brand-light/[.07] p-4">
                        <p class="font-display text-[15px] font-bold text-white">Altyapı</p>
                        <p class="mt-1 text-[13.5px] text-white/55">Veri erişimi, kimlik doğrulama</p>
                    </div>
                    <div class="rounded-xl border border-white/10 bg-white/[.03] p-4">
                        <p class="font-display text-[15px] font-bold text-white">Çekirdek</p>
                        <p class="mt-1 text-[13.5px] text-white/55">Varlıklar, sabit kurallar</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ------------------------------------------------------------ Hizmetler *@
<section class="border-b border-line bg-white">
    <div class="kapsayici py-20 lg:py-28">

        <div class="max-w-2xl" data-reveal>
            <p class="etiket">Ne yapıyorum</p>
            <h2 class="baslik-bolum mt-5">Uçtan uca çalışan çözümler</h2>
            <p class="mt-5 text-[17px] leading-[1.75]">
                Bir ürünün ayakta kalmasını sağlayan şey görünen kısmı değil, altındaki
                yapıdır. Odağım orası.
            </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal>

            <article class="kart kart-etkilesimli p-8">
                <span class="ikon-kutu" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="6" rx="2" />
                        <rect x="3" y="14" width="18" height="6" rx="2" />
                        <path d="M7 7h.01M7 17h.01" />
                    </svg>
                </span>

                <h3 class="mt-6 text-[19px] font-bold">Arka uç geliştirme</h3>
                <p class="mt-3 text-[15.5px] leading-[1.7]">
                    .NET ile servis ve API geliştiriyorum. Katmanlı mimari, temiz sözleşmeler
                    ve testlerle desteklenen bir yapı kuruyorum.
                </p>
            </article>

            <article class="kart kart-etkilesimli p-8">
                <span class="ikon-kutu" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z" />
                        <path d="M12 12v9M12 12 3 7.5M12 12l9-4.5" />
                    </svg>
                </span>

                <h3 class="mt-6 text-[19px] font-bold">Çok kiracılı mimari</h3>
                <p class="mt-3 text-[15.5px] leading-[1.7]">
                    Tek kod tabanında her müşterinin verisini birbirinden yalıtan yapılar
                    kuruyorum. Yetkilendirme rol ve izin seviyesinde çözülür.
                </p>
            </article>

            <article class="kart kart-etkilesimli p-8">
                <span class="ikon-kutu" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2.5" y="4" width="19" height="14" rx="2" />
                        <path d="M2.5 9h19M8 21h8" />
                    </svg>
                </span>

                <h3 class="mt-6 text-[19px] font-bold">Arayüz geliştirme</h3>
                <p class="mt-3 text-[15.5px] leading-[1.7]">
                    Gerektiğinde arayüzü de ben tamamlıyorum. Vue.js ve Tailwind ile
                    hızlı, erişilebilir ve responsive ekranlar.
                </p>
            </article>

        </div>
    </div>
</section>

@* --------------------------------------------------------------- Süreç *@
<section class="bg-surface">
    <div class="kapsayici py-20 lg:py-28">

        <div class="grid gap-14 lg:grid-cols-[1fr_1.3fr]">

            <div data-reveal>
                <p class="etiket">Nasıl çalışıyorum</p>
                <h2 class="baslik-bolum mt-5">Önce sorular, sonra kod</h2>
                <p class="mt-5 text-[17px] leading-[1.75]">
                    Sonradan sökülmesi pahalı kararları başta vermemek için belirli bir
                    sırayla ilerliyorum.
                </p>

                <a class="dugme dugme-ikincil mt-8" asp-controller="Home" asp-action="About">
                    Hakkımda daha fazlası
                    <span aria-hidden="true">→</span>
                </a>
            </div>

            <ol class="space-y-5" data-reveal>
                <li class="kart flex gap-5 p-7">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink font-display text-[14px] font-bold text-white" aria-hidden="true">1</span>
                    <div>
                        <h3 class="text-[17px] font-bold">Kuralları netleştir</h3>
                        <p class="mt-2 text-[15.5px] leading-[1.7]">
                            Veri nereye yazılır, kim neye erişir, hata olduğunda ne olur.
                            Bunlar netleşmeden yazılan kod ileride borç olur.
                        </p>
                    </div>
                </li>

                <li class="kart flex gap-5 p-7">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink font-display text-[14px] font-bold text-white" aria-hidden="true">2</span>
                    <div>
                        <h3 class="text-[17px] font-bold">Katmanları ayır</h3>
                        <p class="mt-2 text-[15.5px] leading-[1.7]">
                            İş kuralları veri erişiminden bağımsız durur. Depolama değişse
                            bile uygulama katmanına dokunulmaz.
                        </p>
                    </div>
                </li>

                <li class="kart flex gap-5 p-7">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink font-display text-[14px] font-bold text-white" aria-hidden="true">3</span>
                    <div>
                        <h3 class="text-[17px] font-bold">Testle sabitle</h3>
                        <p class="mt-2 text-[15.5px] leading-[1.7]">
                            Kritik davranışları testlerle kilitliyorum; böylece sonraki
                            değişiklik eskiyi sessizce bozmuyor.
                        </p>
                    </div>
                </li>
            </ol>

        </div>
    </div>
</section>

@* ------------------------------------------------------------- CTA bandı *@
<section class="koyu-bolum">
    <div class="kapsayici py-16 lg:py-20">
        <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between" data-reveal>

            <div>
                <h2 class="baslik-bolum text-white">Bir projeniz mi var?</h2>
                <p class="mt-4 max-w-[52ch] text-[17px] leading-[1.7] text-white/65">
                    Fikrinizi konuşalım. E-posta en hızlısı; genellikle aynı gün dönüyorum.
                </p>
            </div>

            <a class="dugme dugme-beyaz shrink-0" asp-controller="Home" asp-action="Contact">
                İletişime geç
                <span aria-hidden="true">→</span>
            </a>

        </div>
    </div>
</section>
