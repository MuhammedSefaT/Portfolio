@{
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Bir iş, bir soru ya da sadece merhaba için iletişim bilgileri.";
}

<section class="reveal d2">

    <p class="etiket">İletişim</p>

    <h1 class="display mt-5 max-w-[20ch] text-[clamp(2rem,5.6vw,3.2rem)] font-semibold">
        Bir iş, bir soru ya da sadece merhaba.
    </h1>

    <p class="mt-7 max-w-[52ch] text-[17px] leading-[1.65] text-slate">
        E-posta en hızlısı; genellikle aynı gün dönüyorum.
    </p>

    <a class="group mt-9 inline-flex items-baseline gap-3 text-[clamp(1.15rem,3.2vw,1.6rem)] font-medium text-ink"
       href="mailto:sefatayaz@gmail.com">
        <span class="underline decoration-royal/40 decoration-2 underline-offset-[8px] transition-colors group-hover:decoration-royal">sefatayaz@gmail.com</span>
        <span class="text-muted transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>

</section>

