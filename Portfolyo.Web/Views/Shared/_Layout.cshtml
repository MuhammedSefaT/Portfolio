@{
    var baslik = ViewData["Title"] as string;
    var sayfaBasligi = string.IsNullOrWhiteSpace(baslik)
        ? "Muhammed Sefa Tayaz"
        : $"{baslik} — Muhammed Sefa Tayaz";

    var aciklama = ViewData["Description"] as string
        ?? "Muhammed Sefa Tayaz — yazılım geliştirici. .NET ile çok kiracılı SaaS ürünlerinin arka ucunu kuruyorum.";

    // Kısa sayfalar dikeyde ortalanır; uzun sayfalar ViewData ile bunu değiştirir.
    var icerikHizalama = ViewData["MainAlign"] as string ?? "justify-center";
}
<!DOCTYPE html>
<html lang="tr" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@sayfaBasligi</title>
    <meta name="description" content="@aciklama" />
    <meta name="author" content="Muhammed Sefa Tayaz" />
    <meta name="theme-color" content="#FAFAFB" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://msefatayaz.com/" />
    <meta property="og:title" content="@sayfaBasligi" />
    <meta property="og:description" content="@aciklama" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='4' fill='%230F172A'/%3E%3Cpath d='M18 44V20h5l9 15 9-15h5v24h-5V29l-7 12h-4l-7-12v15z' fill='%23FAFAFB'/%3E%3C/svg%3E" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* Gizleme kuralları yalnızca JavaScript varken uygulansın diye en başta çalışır. *@
    <script>document.documentElement.classList.remove('no-js');</script>
</head>
<body class="min-h-[100svh] font-sans text-ink antialiased selection:bg-ink selection:text-paper">

    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-[14px] focus:text-paper"
       href="#icerik">İçeriğe geç</a>

    <div class="mx-auto flex min-h-[100svh] max-w-4xl flex-col px-6 sm:px-10">

        <header class="reveal d1 sticky top-0 z-40 -mx-6 flex items-center justify-between gap-4 border-b border-hairline bg-paper/85 px-6 py-5 backdrop-blur-sm sm:-mx-10 sm:px-10">
            <a class="text-[15px] font-medium tracking-tight text-ink" asp-controller="Home" asp-action="Index">msefatayaz.com</a>

            <nav class="meta flex items-center gap-5 text-muted sm:gap-7" aria-label="Bölümler">
                <a class="transition-colors hover:text-ink" href="/#hakkimda">hakkımda</a>
                <a class="hidden transition-colors hover:text-ink sm:inline" href="/#teknoloji">teknoloji</a>
                <a class="transition-colors hover:text-ink" href="/#projeler">projeler</a>
                <a class="transition-colors hover:text-ink" href="/#iletisim">iletişim</a>
            </nav>
        </header>

        <main id="icerik" class="flex flex-1 flex-col @icerikHizalama py-16 sm:py-20">
            @RenderBody()
        </main>

        <footer class="flex flex-col gap-3 border-t border-hairline py-6 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
            <p>&copy; @DateTime.Now.Year Muhammed Sefa Tayaz</p>
            <p class="meta">Türkiye</p>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
