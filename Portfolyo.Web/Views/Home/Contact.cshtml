@{
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Bir iş, bir soru ya da sadece merhaba için iletişim bilgileri.";
}

<header class="reveal d2">
    <h1 class="display text-[clamp(2.2rem,6.4vw,3.6rem)] font-semibold">
        İletişim
    </h1>

    <p class="mt-6 max-w-[56ch] text-[18px] leading-[1.6] text-slate">
        Bir iş, bir soru ya da sadece merhaba. E-posta en hızlısı; genellikle
        aynı gün dönüyorum.
    </p>

    <div class="mt-10 h-[3px] w-20 bg-royal" aria-hidden="true"></div>
</header>

<section class="reveal d3 mt-14">

    <a class="group flex flex-col gap-4 bg-ink p-8 text-paper transition-colors hover:bg-royal sm:flex-row sm:items-center sm:justify-between sm:p-10"
       href="mailto:sefatayaz@gmail.com">
        <span>
            <span class="block text-[13px] font-medium uppercase tracking-[.08em] text-paper/50">E-posta</span>
            <span class="mt-2 block text-[clamp(1.15rem,3.2vw,1.6rem)] font-medium">sefatayaz@gmail.com</span>
        </span>

        <span class="text-[22px] transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>

</section>

<section class="mt-16" data-reveal>

    <h2 class="display text-[clamp(1.5rem,3.6vw,2rem)] font-semibold">Diğer kanallar</h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">

        <a class="group border border-hairline p-7 transition-colors hover:border-royal"
           href="https://github.com/MuhammedSefaT" target="_blank" rel="noopener">
