@{
    ViewData["Title"] = null;
}

<section class="flex min-h-[52svh] flex-col justify-center">

    <p class="reveal d2 etiket">Yazılım geliştirici</p>

    <h1 class="reveal d2 display mt-5 max-w-2xl text-[clamp(2.4rem,7.2vw,4.4rem)] font-semibold">
        Muhammed Sefa Tayaz
    </h1>

    <p class="reveal d3 mt-7 max-w-[54ch] text-[17px] leading-[1.65] text-slate sm:text-[18px]">
        Çok kiracılı SaaS ürünlerinin arka ucunu kuruyorum: tek kod tabanı, birbirinden
        yalıtılmış müşteri verisi. Arayüz gerektiğinde Vue.js ile tamamlıyorum.
    </p>

    <div class="reveal d4 mt-10 flex flex-wrap items-center gap-x-4 gap-y-3">
        <a class="bg-ink px-6 py-3 text-[15px] font-medium text-paper transition-colors hover:bg-royal"
           asp-controller="Home" asp-action="Projects">
            Projelerimi gör
        </a>

        <a class="px-2 py-3 text-[15px] text-ink underline decoration-royal/40 decoration-2 underline-offset-[6px] transition-colors hover:decoration-royal"
           asp-controller="Home" asp-action="Contact">
            İletişime geç
        </a>
    </div>

</section>

<section class="mt-24 border-t border-hairline pt-12 sm:mt-32" data-reveal>

    <p class="etiket">Ne yapıyorum</p>

    <div class="mt-8 grid gap-10 sm:grid-cols-3 sm:gap-8">

        <div>
            <h2 class="text-[17px] font-semibold text-ink">Arka uç</h2>
            <p class="mt-3 text-[15px] leading-[1.65] text-slate">
                .NET ile servis ve API yazıyorum. Veri nereye yazılır, kim neye erişir,
                hata olduğunda ne olur — önce bunları netleştiriyorum.
            </p>
        </div>

        <div>
            <h2 class="text-[17px] font-semibold text-ink">Çok kiracılı yapı</h2>
            <p class="mt-3 text-[15px] leading-[1.65] text-slate">
                Tek kod tabanında her müşterinin verisini ayrı tutan katmanları kuruyorum.
                Yetkilendirme rol ve izin seviyesinde.
            </p>
        </div>

        <div>
            <h2 class="text-[17px] font-semibold text-ink">Arayüz</h2>
            <p class="mt-3 text-[15px] leading-[1.65] text-slate">
                Gerektiğinde Vue.js ve Tailwind ile arayüzü de ben tamamlıyorum.
                Bu site de öyle yazıldı.
            </p>
        </div>

    </div>

    <a class="mt-10 inline-flex items-center gap-2 text-[15px] text-ink underline decoration-royal/40 decoration-2 underline-offset-[6px] transition-colors hover:decoration-royal"
       asp-controller="Home" asp-action="About">
        Hakkımda daha fazlası
        <span aria-hidden="true">→</span>
    </a>

</section>
