@{
    ViewData["Title"] = "Projelerim";
    ViewData["Description"] = "Üzerinde çalıştığım projeler ve kullandığım yaklaşımlar.";
}

<section class="reveal d2">

    <p class="etiket">Projelerim</p>

    <h1 class="display mt-5 max-w-[20ch] text-[clamp(2rem,5.6vw,3.2rem)] font-semibold">
        Üzerinde çalıştığım işler
    </h1>

    <p class="mt-7 max-w-[54ch] text-[17px] leading-[1.65] text-slate">
        Her projeyi ne yaptığı, hangi sorunu çözdüğü ve nasıl kurulduğuyla birlikte
        anlatacağım. Liste burada toplanacak.
    </p>

</section>

<section class="mt-14" data-reveal>

    <div class="border border-dashed border-hairline p-8 sm:p-12">

        <p class="flex items-center gap-2.5 text-[14px] font-medium text-muted">
            <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-ember" aria-hidden="true"></span>
            Hazırlanıyor
        </p>

        <p class="mt-5 max-w-[52ch] text-[17px] leading-[1.65] text-slate">
            Bu sayfa şu an boş. Projeleri tek tek ekleyene kadar yazdığım koda
            GitHub üzerinden bakabilirsin.
        </p>

        <a class="mt-8 inline-flex items-center gap-2 bg-ink px-6 py-3 text-[15px] font-medium text-paper transition-colors hover:bg-royal"
           href="https://github.com/MuhammedSefaT" target="_blank" rel="noopener">
            GitHub'daki depolara bak
            <span aria-hidden="true">→</span>
        </a>

    </div>

</section>
