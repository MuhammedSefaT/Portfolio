@model ErrorViewModel
@{
    ViewData["Title"] = "Bir şeyler ters gitti";
    ViewData["Etiket"] = "Hata";
    ViewData["Lede"] = "İsteğiniz işlenirken beklenmeyen bir sorun yaşandı.";
}

<partial name="_SayfaBasligi" />

<section class="bg-white">
    <div class="kapsayici py-20 lg:py-28">
        <div class="kart mx-auto max-w-2xl p-10 lg:p-12" data-reveal>
            <h2 class="text-[19px] font-bold">Ne yapabilirsiniz?</h2>
            <p class="mt-4 text-[16.5px] leading-[1.75]">
                Sayfayı yenilemeyi deneyebilir ya da ana sayfaya dönebilirsiniz.
                Sorun sürerse bana yazabilirsiniz.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="mt-6 rounded-lg bg-surface px-4 py-3 text-[14px]">
                    <span class="font-semibold text-ink">İstek No:</span>
                    <span class="text-muted">@Model.RequestId</span>
                </p>
            }

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a class="dugme dugme-birincil" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
                <a class="dugme dugme-ikincil" asp-controller="Home" asp-action="Contact">İletişime geç</a>
            </div>
        </div>
    </div>
</section>
