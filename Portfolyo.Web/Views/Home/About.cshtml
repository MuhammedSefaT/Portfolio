@{
    ViewData["Title"] = "Hakkımda";
    ViewData["Description"] = "Muhammed Sefa Tayaz kimdir, nasıl çalışır ve hangi araçları kullanır.";
}

<section class="grid gap-12 sm:grid-cols-[minmax(0,1fr)_18rem] sm:items-start sm:gap-14">

    <div class="reveal d2">
        <p class="etiket">Hakkımda</p>

        <h1 class="display mt-5 max-w-[18ch] text-[clamp(2rem,5.6vw,3.2rem)] font-semibold">
            Sistemin kurallarını netleştirmeyi severim.
        </h1>

        <div class="mt-8 max-w-[56ch] space-y-5 text-[17px] leading-[1.7] text-slate">
            <p>
                Arka uçta çalışıyorum. Bir işe başlarken önce soruları yanıtlıyorum:
                veri nereye yazılır, kim neye erişir, bir şey ters gittiğinde ne olur.
                Bu üçü netleşmeden kod yazmak, sonradan sökülmesi zor kararlar demek.
            </p>
            <p>
                .NET ile servis ve API geliştiriyorum. Çok kiracılı yapılarda her müşterinin
                verisini birbirinden ayrı tutan katmanları kuruyorum; yetkilendirmeyi rol ve
                izin seviyesinde çözüyorum. Arayüz gerektiğinde Vue.js ve Tailwind ile
                tamamlıyorum.
            </p>
            <p>
                Bu siteyi de sıfırdan yazıyorum: veritabanı yerine JSON dosyaları, katmanlı
                bir klasör yapısı ve testlerle.
            </p>
        </div>
    </div>

    @* Kendi fotoğrafını eklemek için: wwwroot/img klasörüne koyup src değerini değiştir. *@
    <figure class="reveal d3 sm:sticky sm:top-28">
        <img class="w-full border border-hairline object-cover"
             src="~/img/portre.svg"
             width="800" height="1000"
             alt="Muhammed Sefa Tayaz" />
        <figcaption class="mt-3 text-[13px] text-muted">Türkiye</figcaption>
    </figure>

</section>

<section class="mt-24 border-t border-hairline pt-12 sm:mt-32" data-reveal>

    <p class="etiket">Kullandığım araçlar</p>

    <div class="mt-9 space-y-8">

        <div class="grid gap-3 sm:grid-cols-[10rem_1fr] sm:items-baseline sm:gap-8">
            <p class="text-[14px] font-medium text-muted">Arka uç</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-ink">
                <li>C#</li>
                <li>.NET</li>
                <li>ASP.NET Core MVC</li>
            </ul>
        </div>

        <div class="grid gap-3 border-t border-hairline pt-8 sm:grid-cols-[10rem_1fr] sm:items-baseline sm:gap-8">
            <p class="text-[14px] font-medium text-muted">Arayüz</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-ink">
                <li>Vue.js</li>
                <li>Tailwind CSS</li>
                <li>JavaScript</li>
            </ul>
        </div>

        <div class="grid gap-3 border-t border-hairline pt-8 sm:grid-cols-[10rem_1fr] sm:items-baseline sm:gap-8">
            <p class="text-[14px] font-medium text-muted">Test ve araçlar</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-ink">
                <li>xUnit</li>
                <li>Git</li>
                <li>AutoMapper</li>
                <li>FluentValidation</li>
            </ul>
        </div>

    </div>

    <a class="mt-12 inline-flex items-center gap-2 text-[15px] text-ink underline decoration-royal/40 decoration-2 underline-offset-[6px] transition-colors hover:decoration-royal"
       asp-controller="Home" asp-action="Contact">
        Benimle iletişime geç
        <span aria-hidden="true">→</span>
    </a>

</section>
